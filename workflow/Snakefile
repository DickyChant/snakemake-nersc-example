# zllv analysis workflow (LPC branch)
#
# Orchestrates the Z -> l l V, V -> h+ h- analysis as a two-stage DAG:
#   Stage A  signal_efficiency : selection-efficiency cutflow over the private-signal NanoAODs
#   Stage B  data_splot        : per-collection ditrack-mass fit -> sWeights -> fitted_mass (Z)
#
# Each rule wraps its command in `env.sh` so it runs inside cmsenv (PyROOT/RooFit) on whatever
# node Snakemake places it -- the LPC interactive shell (local executor) or an HTCondor worker.
#
# Run (from the repo root, inside `pixi shell`):
#   snakemake --cores 4 --printshellcmds --snakefile workflow/Snakefile          # or: pixi run zllv
#   snakemake -n --snakefile workflow/Snakefile                                  # dry-run the DAG

configfile: "config.yaml"

ADIR  = config["analysis_dir"]
OUT   = config["outdir"]
ENV   = config["env_wrapper"]
COLLS = config["data_collections"]

rule all:
    input:
        OUT + "/eff_signal.png",
        expand(OUT + "/{coll}_splot_Zsignal.png", coll=COLLS),

# Stage A -- signal selection efficiency (one cutflow over all private-signal processes).
rule signal_efficiency:
    output:
        png  = OUT + "/eff_signal.png",
        root = OUT + "/eff_signal.root",
    shell:
        "{ENV} python3 {ADIR}/signal_efficiency.py"

# Stage B -- data sPlot, one job per candidate collection (fans out over data_collections).
rule data_splot:
    output:
        zsig   = OUT + "/{coll}_splot_Zsignal.png",
        fit    = OUT + "/{coll}_ditrack_fit.png",
        panels = OUT + "/{coll}_splot_panels.png",
        root   = OUT + "/{coll}_splot.root",
    params:
        mf = config["splot"]["max_files"],
        mc = config["splot"]["max_cands"],
    shell:
        "{ENV} python3 {ADIR}/data_splot.py -c {wildcards.coll} "
        "--max-files {params.mf} --max-cands {params.mc}"
